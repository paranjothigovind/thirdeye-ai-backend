# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# LLM generation provider: azure_openai (default) | anthropic
# Embeddings ALWAYS use Azure OpenAI, whichever provider generates answers.
# ---------------------------------------------------------------------------
LLM_PROVIDER=azure_openai
# Prior user/assistant turns from the request forwarded to the model (0 = none)
LLM_MAX_HISTORY_MESSAGES=10

# Anthropic Claude (required only when LLM_PROVIDER=anthropic).
# API usage is billed per token to your Anthropic Console account; a Claude
# Pro/Max subscription does not include API access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=2
# low | medium | high | xhigh | max (leave empty to use the model default)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set false to disable. Disabled automatically
# for models where it is not documented (see ARCHITECTURE.md model matrix).
ANTHROPIC_REFUSAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Public chat limits (set before enabling Claude publicly)
# ---------------------------------------------------------------------------
CHAT_MAX_MESSAGES=40
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_TOTAL_CHARS=24000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_HOUR=120
SESSION_DAILY_TOKEN_LIMIT=300000
# Total LLM tokens per UTC day across all users (0 = unlimited). One chat uses roughly
# 3,500-4,500 tokens, so 1,000,000 is about 220-280 chats/day. Default is 1000000.
LLM_DAILY_TOKEN_BUDGET=1000000
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header)
TRUSTED_PROXY_HOPS=0
# memory (single instance) or redis (shared limits across instances, uses REDIS_URL)
USAGE_STORE=memory
# Seconds between SSE keep-alive comments while a response is prepared (0 = off)
SSE_KEEPALIVE_SECONDS=15

# Region emergency policy (see emergency_policy.example.json). Empty = generic
# guidance with no phone numbers.
EMERGENCY_POLICY_FILE=

# ---------------------------------------------------------------------------
# Azure OpenAI (embeddings always; chat when LLM_PROVIDER=azure_openai)
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT_CHAT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# Azure AI Search (index schema and vectors are unchanged by the LLM provider)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=thirdeye-knowledge-index-v2

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=third-eye-pdfs

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///./thirdeye.db

# Authentication. REQUIRED: the app refuses to start without these (no default).
# Use two different random values of 32+ characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Razorpay (LMS course payments). Use TEST mode keys (rzp_test_...) until launch.
# Secrets stay on the server; the mobile app only receives RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
